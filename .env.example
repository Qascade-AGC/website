# Contact form — use Resend OR Formspree (at least one required in production)

# Option A: Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
# Verified sender, e.g. contact@yourdomain.com — omit to use Resend sandbox sender
# RESEND_FROM=Qascade <contact@qascade.dev>
# Override inbox (defaults to hermes-93@outlook.com from data/contact.ts)
# CONTACT_TO=hermes-93@outlook.com

# Formspree — https://formspree.io/f/mbgjozro
FORMSPREE_FORM_ID=mbgjozro
# Możesz też wkleić pełny URL zamiast samego ID
